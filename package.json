{
  "name": "@milindkusahu/site-kit",
  "version": "1.3.0",
  "description": "Shared SEO core, quality checks, security headers and test helpers for Next.js and Astro sites.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/milindkusahu/site-kit.git"
  },
  "bin": {
    "site-kit": "bin/site-kit.mjs"
  },
  "files": [
    "bin",
    "dist",
    "checks",
    "assets",
    "eslint",
    "headers"
  ],
  "exports": {
    "./seo/*": {
      "types": "./dist/seo/*.d.ts",
      "default": "./dist/seo/*.js"
    },
    "./playwright/*": {
      "types": "./dist/playwright/*.d.ts",
      "default": "./dist/playwright/*.js"
    },
    "./agent/*": {
      "types": "./dist/agent/*.d.ts",
      "default": "./dist/agent/*.js"
    },
    "./audit": {
      "types": "./checks/audit/index.d.mts",
      "default": "./checks/audit/index.mjs"
    },
    "./headers": {
      "types": "./headers/security.d.mts",
      "default": "./headers/security.mjs"
    },
    "./eslint": "./eslint/index.mjs",
    "./secrets": "./checks/secrets.mjs",
    "./sw.js": "./assets/sw.js",
    "./package.json": "./package.json",
    "./eslint/shared": "./eslint/shared.mjs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "bun run typecheck && bun run test && bun run build && node bin/site-kit.mjs secrets && git diff --exit-code -- dist"
  },
  "dependencies": {
    "chrome-launcher": "^1.2.3",
    "dependency-cruiser": "^18.7.2",
    "lighthouse": "^13.6.0",
    "node-html-markdown": "^2.0.0",
    "node-html-parser": "^9.0.7",
    "sharp": "^0.35.5"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.50",
    "eslint": ">=9"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.5",
    "eslint": "^9",
    "fast-check": "^4.10.2",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
